    {
      "id": "claim_673b0034d73c47fdbc381c7002a25127",
      "statement": "`store.Open` creates `<dataDir>/projects`, opens `<dataDir>/v1.db`, sets `SetMaxOpenConns(1)`, applies `PRAGMA journal_mode=WAL` and `PRAGMA busy_timeout=5000`, then calls `migrate`.",
      "evidence": [
        {
          "resource": "repo://internal/store/store.go#L36-L60",
          "version": "repo-lines-v1:sha256:e407d4888124fd217037fbd9e6cd21375b3c58c68d7c031c6f166c0de0a8abda:"
        }
      ]
    },
    {
      "id": "claim_8a8ddcd856964f61ab01faf801cdc679",
      "statement": "`migrate` is a single idempotent function with no schema version table: it runs one `CREATE TABLE IF NOT EXISTS` script, per-table `migrateAddColumns` calls, two `rebuildTableForSessions` rebuilds, then `migrateLegacyUsers`, `markLegacyAgentRows` and `scrubStoredMessages`.",
      "evidence": [
        {
          "resource": "repo://internal/store/store.go#L197-L330",
          "version": "repo-lines-v1:sha256:5a380fafdff58fed91d76009276a65ccb126a4e854d02fc301f9e04282c9eb04:"

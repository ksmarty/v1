  "claims": [
    {
      "id": "claim_7fd2ec84462e4f79bbb2e92f90abde76",
      "statement": "Go stays the owner of the HTTP API, auth, the store and the tools; it spawns the sidecar, keeps it alive, and answers the sidecar's tool and approval calls, which run the model and the durable transcript.",
      "evidence": [
        {
          "resource": "repo://internal/harness/rpc.go#L1-L31",
          "version": "repo-lines-v1:sha256:ff35ce4dbddbdc139f1e79d216a950c5f4b3e2977615f936dd8b48849e6cefea:"
        }
      ]
    },
    {
      "id": "claim_1941701afe71473a95222548d464f69c",
      "statement": "The bridge speaks newline-delimited JSON-RPC 2.0 over a Unix socket, one object per line, capped at 32 MiB; both sides report protocol version 1 in the handshake and a mismatch is a startup failure because they ship in the same image.",
      "evidence": [
        {
          "resource": "repo://internal/harness/rpc.go#L20-L31",
          "version": "repo-lines-v1:sha256:4c7f4993f9633be97cab804b5b833afbc8e06a8985cfdf50c68cb0d5587f5cec:"
        },
        {
          "resource": "repo://internal/harness/rpc.go#L65-L73",
          "version": "repo-lines-v1:sha256:383ebfc760ce41b6199d248663822f653e1c772e5f70ead316852b5247d5040e:"
        }
      ]
    },
    {
      "id": "claim_d8e8463e995644fa9296e1478eb24918",
      "statement": "Requests such as host.call and approval prompts may block on the user, but event notifications are delivered in order on the single read loop, so a slow notification handler stalls every later message.",
      "evidence": [
        {
          "resource": "repo://internal/harness/rpc.go#L65-L80",
          "version": "repo-lines-v1:sha256:7ac307a479d88a4ac50fdcaf1d4960c576c257fa96024e1f228e469d129dd3f8:"
        }
      ]
    },
    {
      "id": "claim_f9384d4e677742b8ac196155fe4e5c8a",
      "statement": "Bridge.Handle answers event batches by pushing them into the subscription's queue, tool.call by routing to the runner registered for that conversation, tool.authorize by returning a block reason, and delegate.attach by recording a child-to-parent alias.",
      "evidence": [
        {
          "resource": "repo://internal/harness/bridge.go#L246-L340",
          "version": "repo-lines-v1:sha256:2169a159a160c335169ede27fccf2dc1c8396517c80aa5c473bfc90b59e87c7c:"
        }
      ]
    },
    {
      "id": "claim_f7b9a580e90549d1afffc039f26839c8",
      "statement": "A tool call with no active runner is answered with an error ToolResult reading 'no active turn for tool <name>' plus a log line, because from the model's side an abandoned turn looks like a tool that mysteriously fails.",
      "evidence": [
        {
          "resource": "repo://internal/harness/bridge.go#L322-L380",

    },
    {
      "id": "claim_2555786c0ec040b5ba088e8738c4cbd2",
      "statement": "Shutdown waits for running turns before tearing anything down, then stops previews and terminals, drains HTTP, and closes the sidecar before the store because the sidecar holds the durable transcript open.",

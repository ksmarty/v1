# Dependencies
node_modules/

# Frontend build output
web/dist/

# Embedded frontend assets (regenerated by `make build` / Docker; .gitkeep stays)
internal/server/dist/*
!internal/server/dist/.gitkeep

# Local runtime data (`make dev`)
data/

# Local binaries
bin/

# Local env overrides
*.local

# Local diagnostics exports (contain private transcript data)
.herdr-web-ui/
